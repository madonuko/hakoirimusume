import { detectMacros, getMacroByName } from '../lib/macro-detect';
import macrosData from '../data/macros/macros.json';

export interface Props {
  name: string;
  args?: string;
}

const { name, args } = Astro.props;
const macroKey = name.toLowerCase();
const macro = macrosData.macros[macroKey];

if (!macro) {
  console.warn(`Macro not found: ${name}`);
}

const fullName = macro?.fullName || `%${name}`;
const description = macro?.description || 'Unknown macro';
const expansion = macro?.expansion;
const parameterized = macro?.parameterized || false;
const category = macro?.category || 'unknown';
---

<span class="rpm-macro-wrapper" data-macro={macroKey}>
  <code class="rpm-macro-code">{fullName}{args ? ` ${args}` : ''}</code>
  <span class="rpm-macro-tooltip" role="tooltip">
    <span class="rpm-macro-tooltip-header">
      <code class="rpm-macro-tooltip-title">{fullName}</code>
      <span class="rpm-macro-category">{category}</span>
    </span>
    <p class="rpm-macro-description">{description}</p>
    {expansion && (
      <div class="rpm-macro-expansion">
        <span class="rpm-macro-expansion-label">Expands to:</span>
        <code class="rpm-macro-expansion-code">{expansion}</code>
      </div>
    )}
    <span class="rpm-macro-hint">Hover for details</span>
  </span>
</span>

<style>
  .rpm-macro-wrapper {
    position: relative;
    display: inline-block;
    cursor: help;
  }

  .rpm-macro-code {
    color: #a855f7;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
    transition: all 0.2s ease;
  }

  .rpm-macro-wrapper:hover .rpm-macro-code {
    background: linear-gradient(135deg, #4c1d95 0%, #5b21b6 100%);
    box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.4);
  }

  .rpm-macro-tooltip {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 320px;
    background: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 0.5rem;
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    z-index: 1000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .rpm-macro-wrapper:hover .rpm-macro-tooltip {
    opacity: 1;
    visibility: visible;
  }

  .rpm-macro-tooltip-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #45475a;
  }

  .rpm-macro-tooltip-title {
    color: #cba6f7;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .rpm-macro-category {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: #6c7086;
    background: #313244;
    padding: 0.125rem 0.375rem;
    border-radius: 9999px;
  }

  .rpm-macro-description {
    color: #cdd6f4;
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  .rpm-macro-expansion {
    margin-top: 0.75rem;
    padding: 0.5rem;
    background: #181825;
    border-radius: 0.25rem;
  }

  .rpm-macro-expansion-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    color: #6c7086;
    margin-bottom: 0.25rem;
  }

  .rpm-macro-expansion-code {
    display: block;
    color: #a6e3a1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    word-break: break-all;
  }

  .rpm-macro-hint {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.7rem;
    color: #6c7086;
    text-align: center;
  }

  @media (max-width: 640px) {
    .rpm-macro-tooltip {
      position: fixed;
      bottom: 1rem;
      left: 1rem;
      right: 1rem;
      max-width: none;
    }
  }
</style>
